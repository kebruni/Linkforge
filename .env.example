# =============================================================================
# Linkforge — environment variables
# Copy to `.env` for local dev, or `.env.production` on the VPS.
# NEVER commit real secrets.
# =============================================================================

# -- App ----------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=Linkforge
PORT=3000

# -- Database (Prisma / Postgres) --------------------------------------------
# docker-compose.dev.yml maps Postgres to host port 5433
DATABASE_URL=postgresql://linkforge:linkforge@localhost:5433/linkforge?schema=public

# -- Redis (cache + BullMQ + rate limit) -------------------------------------
REDIS_URL=redis://localhost:6379

# -- Auth.js / NextAuth v5 ---------------------------------------------------
# Generate with:  openssl rand -base64 32
AUTH_SECRET=replace-me-with-32-bytes-base64
AUTH_TRUST_HOST=true

# OAuth providers (leave blank to disable)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Email magic-link / verification (use SMTP relay or Resend/Postmark)
EMAIL_FROM=no-reply@kebruni.me
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Telegram login widget (bot token + bot username)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# -- Storage (S3-compatible: Cloudflare R2, AWS, MinIO) ----------------------
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=linkforge-assets
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# -- Payments (Stripe) -------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# -- AI features (OpenAI-compatible) -----------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# -- Analytics / GEO ---------------------------------------------------------
MAXMIND_LICENSE_KEY=

# -- Observability -----------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=

# -- Security ----------------------------------------------------------------
TRUSTED_ORIGINS=
# true behind Nginx/Cloudflare so rate limits use real client IP
TRUST_PROXY=false
RATE_LIMIT_WRITES_PER_MIN=60
RATE_LIMIT_PUBLIC_VIEWS_PER_MIN=600

# -- Captcha (optional Cloudflare Turnstile on public forms) -----------------
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# -- Feature flags -----------------------------------------------------------
FEATURE_AI=true
# Set true + Stripe keys to enable PRO checkout, donations, products
FEATURE_BILLING=true
# Dev-only demo checkout without Stripe. Always false in production.
FEATURE_BILLING_DEMO=true
# Enable custom domain attachment + DNS TXT verification (PRO users)
FEATURE_CUSTOM_DOMAINS=true

# Stripe webhook URL (configure in Stripe Dashboard):
#   {APP_URL}/api/billing/webhook

# =============================================================================
# Production (.env.production on VPS at /srv/linkforge)
# Use Docker service hostnames, not localhost.
# =============================================================================
# NODE_ENV=production
# APP_URL=https://linkforge.kebruni.me
# APP_NAME=Linkforge
#
# # Postgres (compose service name: postgres)
# POSTGRES_USER=linkforge
# POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# POSTGRES_DB=linkforge
# DATABASE_URL=postgresql://linkforge:CHANGE_ME_STRONG_PASSWORD@postgres:5432/linkforge?schema=public
#
# # Redis (compose service name: redis)
# REDIS_URL=redis://redis:6379
#
# AUTH_SECRET=GENERATE_WITH_openssl_rand_base64_32
# AUTH_TRUST_HOST=true
#
# # Optional OAuth / AI / Stripe
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# OPENAI_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
#
# FEATURE_AI=true
# FEATURE_BILLING=false
FEATURE_BILLING_DEMO=true
# FEATURE_CUSTOM_DOMAINS=false
# LOG_LEVEL=info
#
# # GitHub Actions secrets (not in this file):
# # VPS_HOST=164.92.240.90
# # VPS_PORT=2222
# # VPS_USER=nurbek
# # VPS_SSH_KEY=<private key>
# # LETSENCRYPT_EMAIL=admin@kebruni.me
